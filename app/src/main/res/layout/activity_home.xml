<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vaya_bg_dark"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/app_name"
        android:textColor="@color/vaya_orange"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:text="Where would you like to go today?"
        android:textColor="@color/vaya_text_muted" />

    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="2"
        android:rowCount="3">

        <Button
            android:id="@+id/btnPlanJourney"
            style="@style/HomeTile"
            android:text="Plan Journey" />

        <Button
            android:id="@+id/btnSavedRoutes"
            style="@style/HomeTile"
            android:text="Saved Routes" />

        <Button
            android:id="@+id/btnLiveAlerts"
            style="@style/HomeTile"
            android:text="Live Alerts" />

        <Button
            android:id="@+id/btnReportIncident"
            style="@style/HomeTile"
            android:text="Report Incident" />

        <Button
            android:id="@+id/btnProfile"
            style="@style/HomeTile"
            android:text="Profile" />

    </GridLayout>

</LinearLayout>
